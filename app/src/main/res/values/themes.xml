<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ITANESTurismo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cyan_500</item>
        <item name="colorTertiary">@color/orange_500</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/navy_900</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.ITANES.Medium</item>
    </style>

    <style name="ShapeAppearance.ITANES.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Widget.ITANES.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.ITANES.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
